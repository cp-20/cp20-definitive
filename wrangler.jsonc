{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cp20-definitive",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // The Worker (worker/index.ts) answers the paths the 2026 edition answered for terminals, and
  // serves the build's Brotli copies of the pages and text files. Pictures (already compressed)
  // are served from the assets without it.
  "main": "worker/index.ts",
  // Only cp20.dev serves the site: no workers.dev address and no preview URLs to index.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/media/*",
      "!/images/*"
    ]
  },
  // cp20.dev was moved here from the 2026 edition (2026-portfolio) on 2026-11-26.
  "routes": [
    {
      "pattern": "cp20.dev",
      "custom_domain": true
    }
  ],
  // The 2026 edition, still at 2026.cp20.dev, answers `curl cp20.dev` and `?raw=true`.
  "services": [
    {
      "binding": "LEGACY",
      "service": "2026-portfolio"
    }
  ]
}
