{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cp20-definitive",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Only the paths the 2026 edition answered for terminals run the Worker (worker/index.ts);
  // the rest are served from the assets without it.
  "main": "worker/index.ts",
  // Only cp20.dev serves the site: no workers.dev address and no preview URLs to index.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/articles",
      "/works",
      "/works/*",
      "/featured-tracks",
      "/featured-series"
    ]
  },
  // cp20.dev is served by LOLIPOP! Deploy Now for now (npm run deploy:lolipop); the Worker has no
  // route until it is moved back. To move back: restore this, which re-attaches the custom domain:
  //   "routes": [{ "pattern": "cp20.dev", "custom_domain": true }],
  // The 2026 edition, still at 2026.cp20.dev, answers `curl cp20.dev` and `?raw=true`.
  "services": [
    {
      "binding": "LEGACY",
      "service": "2026-portfolio"
    }
  ]
}
