{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cp20-definitive",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
