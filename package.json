{
  "name": "cp20-definitive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4321",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4321",
    "sync": "node --env-file-if-exists=.env.sync scripts/sync.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "wrangler dev --ip 0.0.0.0 --port 8787",
    "firebase:rules": "firebase deploy --only database:portfolio-stamps --project cp20-platform",
    "cache:images": "node scripts/cache-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "@solidjs/web": "2.0.0-rc.10",
    "fast-xml-parser": "^5.11.1",
    "firebase": "12.19.0",
    "image-size": "2.0.4",
    "lucide": "1.48.0",
    "solid-js": "2.0.0-rc.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@types/node": "^26.6.3",
    "prettier": "3.8.3",
    "typescript": "^6.0.3",
    "vite": "8.1.2",
    "wrangler": "^4.141.0"
  }
}
