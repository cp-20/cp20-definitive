{
  "name": "cp20-definitive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4321",
    "build": "vite build && node scripts/build/prerender.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4321",
    "sync": "node --env-file-if-exists=.env.sync scripts/sync/sync.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "verify": "npm run check && npm run build && npm test",
    "deploy": "npm run verify && wrangler deploy",
    "dev:worker": "wrangler dev --ip 0.0.0.0 --port 8787",
    "rules": "node scripts/firebase/rules.ts",
    "firebase:rules": "node scripts/firebase/rules.ts --check && firebase deploy --only database:portfolio-stamps --project cp20-platform",
    "cache:images": "node scripts/sync/images.ts",
    "screenshots": "node scripts/sync/screenshots.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "@solidjs/web": "2.0.0-rc.10",
    "fast-xml-parser": "^5.11.1",
    "firebase": "12.19.0",
    "image-size": "2.0.4",
    "lucide": "1.48.0",
    "solid-js": "2.0.0-rc.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@types/node": "^26.6.3",
    "@types/subset-font": "2.3.0",
    "budoux": "0.9.3",
    "harfbuzzjs": "1.6.4",
    "jsqr": "1.4.0",
    "node-html-parser": "9.0.4",
    "prettier": "3.8.3",
    "sharp": "^0.35.4",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "uqr": "0.1.3",
    "vite": "8.1.2",
    "vitest": "5.0.5",
    "wrangler": "^4.141.0"
  }
}
