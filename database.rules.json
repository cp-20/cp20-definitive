{
  "rules": {
    ".read": false,
    ".write": false,
    "pages": {
      "$page": {
        ".validate": "$page.matches(/^(home|about|articles|works|works--minna-no-monosashi|works--2026-portfolio|works--2025-portfolio|works--isuc|works--foodmoji|works--trap-conference|works--wsh-scoring-tool|works--c-compiler|works--traq-ing|works--2024-portfolio|works--tokyo-tech-syllabus|works--read-stack|works--dice-spec-v2|works--trap-mission|works--2023-portfolio|works--titech-lecture-list|works--no-log-chat|works--dice-spec-v1)$/)",
        ".indexOn": ["updatedAt"],
        ".read": "query.orderByChild == 'updatedAt' && query.limitToLast != null && query.limitToLast <= 100",
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && (!newData.exists() || newData.parent().parent().parent().child('throttle').child(auth.uid).child('at').val() == now)",
          ".validate": "newData.getPriority() == null && (newData.hasChildren(['updatedAt','stamps']) && newData.child('updatedAt').val() == now)",
          "updatedAt": {
            ".validate": "newData.getPriority() == null && (newData.val() == now)"
          },
          "stamps": {
            ".validate": "newData.getPriority() == null && (newData.hasChildren())",
            "$slot": {
              ".validate": "newData.getPriority() == null && ($slot.matches(/^[0-4]$/) && newData.hasChildren(['anchor','x','y','kind','angle','createdAt']))",
              "anchor": {
                ".validate": "newData.getPriority() == null && (newData.isString() && newData.val().matches(/^[a-z0-9-]{1,96}$/))"
              },
              "x": {
                ".validate": "newData.getPriority() == null && (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1)"
              },
              "y": {
                ".validate": "newData.getPriority() == null && (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1)"
              },
              "kind": {
                ".validate": "newData.getPriority() == null && (newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 == 0)"
              },
              "angle": {
                ".validate": "newData.getPriority() == null && (newData.isNumber() && newData.val() >= -20 && newData.val() <= 20)"
              },
              "createdAt": {
                ".validate": "newData.getPriority() == null && (newData.isNumber() && (newData.val() == now || (data.exists() && newData.val() == data.val())))"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "avatar": {
            ".validate": "newData.getPriority() == null && (newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/))"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "throttle": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && newData.exists() && (!data.exists() || now >= data.child('at').val() + 1000)",
        ".validate": "newData.getPriority() == null && (newData.hasChildren(['at','prev']) && newData.child('at').val() == now && ((!data.exists() && newData.child('prev').val() == 0) || (data.exists() && newData.child('prev').val() == data.child('at').val())))",
        "at": {
          ".validate": "newData.getPriority() == null && (newData.isNumber())"
        },
        "prev": {
          ".validate": "newData.getPriority() == null && (newData.isNumber())"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
